# Normalize line endings so Windows/Mac/Linux contributors produce clean diffs.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.glb binary
*.blend binary
*.fbx binary
*.ttf binary
*.otf binary

# If art/audio gets big, switch these to Git LFS, e.g.:
# *.blend filter=lfs diff=lfs merge=lfs -text
# *.wav   filter=lfs diff=lfs merge=lfs -text
