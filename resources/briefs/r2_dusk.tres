[gd_resource type="Resource" script_class="Brief" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/briefs/brief.gd" id="1_brief"]
[ext_resource type="Resource" path="res://resources/scoring/dusk_scoring_config.tres" id="2_cfg"]
[ext_resource type="Script" path="res://scripts/briefs/brief_requirement.gd" id="3_req"]

[sub_resource type="Resource" id="Requirement_noise"]
script = ExtResource("3_req")
metric = "noise"
value = 0.5
label = "Keep the grain down (Noise 0.5+, ISO 1600 or lower)"

[resource]
script = ExtResource("1_brief")
title = "Dusk Portrait"
ask = "The light's nearly gone. I want a clean portrait, not a grainy mess. You'll have to trade shutter, aperture, and ISO against each other."
target_stars = 4
shot_limit = 6
config = ExtResource("2_cfg")
requirements = Array[ExtResource("3_req")]([SubResource("Requirement_noise")])
reward = 150
scene_ev = 2.0
sun_energy = 0.35
sun_color = Color(1, 0.62, 0.4, 1)
sky_top_color = Color(0.12, 0.13, 0.3, 1)
sky_horizon_color = Color(0.85, 0.48, 0.32, 1)
render_gain = 2.2
wander_range = 0.8
wander_speed = 0.5
